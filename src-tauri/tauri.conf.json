{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minimarket-app",
  "version": "1.0.0",
  "identifier": "com.denni.minimarket-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "minimarket-app",
        "width": 1024,
        "height": 768,
        "maximized": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sync": {
      "key": "MiniMarket-Secure-Sync-Key-2026",
      "port": 8080
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "licencia.rtf",
    "windows": {
      "nsis": {
        "languages": [
          "SpanishInternational"
        ]
      },
      "wix": {
        "language": {
          "es-ES": {
            "localePath": "idioma.wxl"
          }
        }
      }
    },
    "resources": []
  }
}